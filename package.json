{
  "name": "@kyzarky/ui",
  "version": "0.1.0",
  "description": "Design tokens for Ky Merritt's apps, as a Tailwind CSS 4 theme with light and dark values",
  "license": "MIT",
  "author": "Ky Merritt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KyzarKy/design-system.git"
  },
  "type": "module",
  "exports": {
    "./theme.css": "./theme.css"
  },
  "files": [
    "theme.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/node": "^4.3.3",
    "@types/node": "^26.6.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
